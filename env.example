# Copiar a .env antes de levantar el proyecto:  cp env.example .env
# El archivo .env NO se versiona (ver .gitignore).
#
# Estos son los valores para DESARROLLO LOCAL.
# Para produccion existe otra plantilla: env.production.example

# --- Proveedor de datos ---
# Valores validos:
#   seed          -> dataset de demostracion deterministico. No necesita internet
#                    ni API key. Es el valor por defecto del codigo.
#   football-data -> datos reales de football-data.org. Requiere FOOTBALL_API_KEY.
FOOTBALL_PROVIDER=seed

# Obligatoria solo si FOOTBALL_PROVIDER=football-data.
# Se obtiene gratis en https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# --- Sincronizacion (solo con football-data) ------------------------------
# OJO: son CODIGOS de liga de football-data.org, NO slugs.
# El codigo los pasa a mayusculas, asi que escribir "laliga" NO coincide.
# Validos: PD (LaLiga) PL (Premier) SA (Serie A) BL1 (Bundesliga) FL1 (Ligue 1)
#          DED (Eredivisie) PPL (Primeira) BSA (Brasileirao) ELC (Championship)
#          CL (Champions League)
SYNC_COMPETITIONS=PD,PL,SA,BL1

# --- Presentacion ---------------------------------------------------------
# Zona horaria con la que se agrupan y muestran las fechas. Se fija en el
# servidor a proposito: si dependiera de la del navegador, el HTML del servidor
# y el del cliente diferirian y React fallaria por hidratacion.
DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires

# --- Base de datos --------------------------------------------------------
# Ruta del archivo SQLite. Si se omite, usa data/pitchpulse.db en la raiz del
# proyecto.
#
# Es SQLite mediante `node:sqlite`: NO hay servidor de base de datos, ni
# DATABASE_URL, ni credenciales. Es un archivo, y punto.
# DB_FILE=data/pitchpulse.db

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
